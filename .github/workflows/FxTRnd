name: FoxTrend Playlist Updater

on:
  workflow_dispatch:
  schedule:
    - cron: '0 * * * *'  # Runs exactly every hour

jobs:
  update-foxtrend-playlist:
    runs-on: ubuntu-latest
    # Using the Playwright container which has all system dependencies pre-installed
    container:
      image: mcr.microsoft.com/playwright:v1.49.0-noble 
    env:
      HOME: /root

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Environment
        run: |
          apt-get update
          apt-get install -y python3-venv curl xvfb
          python3 -m venv venv
          source venv/bin/activate
          pip install playwright==1.49.0
          # Install the branded Chrome for DRM/Codec support
          playwright install chrome
        shell: bash

      - name: Download FoxTrend Scraper
        run: |
          # Downloading your specific FoxTrnd.py script
          curl -L -o "$GITHUB_WORKSPACE/FoxTrnd.py" "https://www.dropbox.com/scl/fi/fsmc8kmvwxg30grwjbpcb/FoxTrnd.py?rlkey=8cdirrbmrbyo8k6rynpx6v0zg&st=oq00iupf&dl=1"
        shell: bash

      - name: Run Scraper with Virtual Display
        run: |
          source venv/bin/activate
          cd "$GITHUB_WORKSPACE"
          # xvfb-run allows 'headless: False' to work in a server environment
          xvfb-run --auto-servernum --server-args="-screen 0 1280x720x24" python FoxTrnd.py
        shell: bash

      - name: Verify Playlist Generation
        run: |
          cd "$GITHUB_WORKSPACE"
          if [ -f "foxtrend_playlist.m3u" ]; then
            echo "✅ foxtrend_playlist.m3u successfully generated."
            ls -lh foxtrend_playlist.m3u
          else
            echo "❌ ERROR: Playlist was not created!"
            ls -R
            exit 1
          fi
        shell: bash

      - name: Upload Playlist to Dropbox
        uses: gomes042/gh-actions-dropbox/files/upload@v1.1.0
        with:
          DROPBOX_APP_KEY: ${{ secrets.DROPBOX_APP_KEY }}
          DROPBOX_APP_SECRET: ${{ secrets.DROPBOX_APP_SECRET }}
          DROPBOX_REFRESH_TOKEN: ${{ secrets.DROPBOX_REFRESH_TOKEN }}
          source_path: foxtrend_playlist.m3u
          DEST_PATH: /MyStuff/foxtrend_playlist.m3u
